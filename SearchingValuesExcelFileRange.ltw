<?xml version="1.0" encoding="utf-16"?>
<SerializationRoot xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <WorkflowType>2</WorkflowType>
    <IsTestCase>false</IsTestCase>
    <UseArgs>false</UseArgs>
    <ColumnsTableTestData />
    <RowsTableTestData />
    <ScriptType>CS</ScriptType>
    <RootContainer>
        <ClassName>LTools.Workflow.View.WFOnlyCode</ClassName>
        <AssemblyName>LTools.Workflow, Version=1.0.6.1, Culture=neutral, PublicKeyToken=null</AssemblyName>
        <Properties>
            <SerializationItem>
                <IsListValue>false</IsListValue>
                <Name>ComponentName</Name>
            </SerializationItem>
            <SerializationItem>
                <IsListValue>false</IsListValue>
                <Name>ComponentID</Name>
                <Value xmlns:q1="http://microsoft.com/wsdl/types/" xsi:type="q1:guid">00000000-0000-0000-0000-000000000000</Value>
            </SerializationItem>
            <SerializationItem>
                <IsListValue>false</IsListValue>
                <Name>ContinueOnException</Name>
                <Value xsi:type="xsd:boolean">false</Value>
            </SerializationItem>
            <SerializationItem>
                <IsListValue>false</IsListValue>
                <Name>Variables</Name>
                <Value xsi:type="ArrayOfScriptVariable" />
            </SerializationItem>
            <SerializationItem>
                <IsListValue>false</IsListValue>
                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;
using DevExpress.Spreadsheet;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		
		List&lt;String&gt; list_namesSearch = (List&lt;String&gt;)wf.GetArgument("in_namesSearch");//Список значений для поиска
		Boolean b_letterCaseAccounting = (Boolean)wf.GetArgument("in_letterCaseAccounting");//Учитывать ли регистр
		
		if(!b_letterCaseAccounting){//Если не учитывать
			list_namesSearch = list_namesSearch.Select(s =&gt; s.ToLower()).ToList();//Уменьшаем регистр всех элементов
		}
		
		Workbook wb_workbookInput = new Workbook();
		wb_workbookInput.LoadDocument((string)wf.GetArgument("in_pathExcelFile"));//Excel файл
		Worksheet ws_worksheetInput = wb_workbookInput.Worksheets[(string)wf.GetArgument("in_nameSheetInExcelFile")];//Лист в  Excel файле
		
		CellRange cr_dataRange = ws_worksheetInput.Range[(string)wf.GetArgument("in_rangeWithInputData")];//Диапазон
		
		Dictionary&lt;String, List&lt;String&gt;&gt; dict_cellDataValues = cr_dataRange
	    	.Cast&lt;Cell&gt;()
	    	.Where(cell =&gt;
		        (b_letterCaseAccounting 
		        ? list_namesSearch.Contains(cell.Value?.ToString() ?? "")
		        : list_namesSearch.Contains(cell.Value?.ToString()?.ToLower() ?? ""))
	    	)
	    	.ToDictionary(
	        	cell =&gt; cell.GetReferenceA1(),
	        	cell =&gt; new List&lt;string&gt; 
	        	{ 
	            	cell.Value?.ToString() ?? ""
	        	}
	    	);//Занесение в словарь в ключ адрес ячейки, в лист значений само значение ячейки
			
		wf.SetArgument("out_cellDataValues", dict_cellDataValues);//Передача в основного робота словаря
    }
}</Value>
            </SerializationItem>
        </Properties>
        <IsBreakpoint>false</IsBreakpoint>
        <IsIgnore>false</IsIgnore>
        <Components />
    </RootContainer>
    <GlobalVariables />
    <Arguments>
        <ScriptVariable>
            <Name>in_rangeWithInputData</Name>
            <Group />
            <Comment>Диапазон с данными в Excel файле</Comment>
            <DataTypeString>String</DataTypeString>
            <Direction>IN</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>in_nameSheetInExcelFile</Name>
            <Group />
            <Comment>Название листа в Excel файле</Comment>
            <DataTypeString>String</DataTypeString>
            <Direction>IN</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>in_pathExcelFile</Name>
            <Group />
            <Comment>Путь к Excel файлу</Comment>
            <DataTypeString>String</DataTypeString>
            <Direction>IN</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>out_cellDataValues</Name>
            <Group />
            <Comment>Словарь с найденными значениями</Comment>
            <DataTypeString>System.Collections.Generic.Dictionary&lt;String,List&lt;String&gt;&gt;</DataTypeString>
            <Direction>OUT</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>in_namesSearch</Name>
            <Group />
            <Comment>Список значений для поиска в диапазоне</Comment>
            <DataTypeString>List&lt;String&gt;</DataTypeString>
            <Direction>IN</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>in_letterCaseAccounting</Name>
            <Group />
            <Comment>Статус учета регистра</Comment>
            <DataTypeString>Boolean</DataTypeString>
            <Direction>IN</Direction>
        </ScriptVariable>
    </Arguments>
    <UseCustomDiagramConnectorFormat>false</UseCustomDiagramConnectorFormat>
</SerializationRoot>